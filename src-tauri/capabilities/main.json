{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the configuration window. Only DeskPresence's own commands and event listening are allowed; file dialogs, links and the log folder are opened by Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-config",
    "allow-save-config",
    "allow-get-runtime-view",
    "allow-set-pin",
    "allow-toggle-pin",
    "allow-set-paused",
    "allow-reconnect-discord",
    "allow-rescan-now",
    "allow-preview-presence",
    "allow-get-icons",
    "allow-get-startup-status",
    "allow-export-config",
    "allow-import-config-preview",
    "allow-apply-import",
    "allow-reset-config",
    "allow-open-log-folder",
    "allow-export-diagnostics",
    "allow-open-external",
    "allow-quit-app"
  ]
}
